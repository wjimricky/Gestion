rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Authentication & Validation Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint: UserPublic
    function isValidUserPublic(data) {
      return data.keys().hasAll(['displayName', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: UserPrivateProfile (PII isolated)
    function isValidUserPrivateProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'analystName', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'analystName', 'updatedAt'])
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 200
        && data.analystName is string
        && data.analystName.size() >= 1
        && data.analystName.size() <= 120
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: RiceProject (native Maps and bounded Lists, zero JSON strings)
    function isValidRiceProject(data) {
      return data.keys().hasAll([
          'id',
          'ownerId',
          'name',
          'description',
          'source',
          'activeScenarioId',
          'assumptions',
          'savedScenarios',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ownerId',
          'name',
          'description',
          'source',
          'activeScenarioId',
          'assumptions',
          'savedScenarios',
          'pestelAnalysis',
          'dashboardReportNotes',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 160
        && data.description is string
        && data.description.size() <= 500
        && data.source in ['default', 'excel', 'copy']
        && isValidId(data.activeScenarioId)
        && data.assumptions is map
        && data.assumptions.size() >= 1
        && data.assumptions.size() <= 80
        && data.savedScenarios is list
        && data.savedScenarios.size() <= 25
        && (data.savedScenarios.size() == 0 || data.savedScenarios[0] is map)
        && (!('pestelAnalysis' in data) || (data.pestelAnalysis is map && data.pestelAnalysis.size() <= 12))
        && (!('dashboardReportNotes' in data) || (data.dashboardReportNotes is string && data.dashboardReportNotes.size() <= 10000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection: users/{userId} (Public-safe analyst metadata, owner-scoped)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPublic(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPublic(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(userId) && isOwner(userId);

      // Subcollection: users/{userId}/private/{docId} (Strict PII Isolation)
      match /private/{docId} {
        allow get: if isValidId(userId)
          && isValidId(docId)
          && docId == 'profile'
          && isOwner(userId);
        allow list: if false;
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'profile'
          && isOwner(userId)
          && isValidUserPrivateProfile(incoming())
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'profile'
          && isOwner(userId)
          && isValidUserPrivateProfile(incoming())
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'analystName', 'updatedAt']);
        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'profile'
          && isOwner(userId);
      }
    }

    // Collection: projects/{projectId}
    match /projects/{projectId} {
      allow get: if isValidId(projectId)
        && isSignedIn()
        && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn()
        && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(projectId)
        && isValidRiceProject(incoming())
        && incoming().id == projectId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(projectId)
        && isValidRiceProject(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'description',
          'source',
          'activeScenarioId',
          'assumptions',
          'savedScenarios',
          'pestelAnalysis',
          'dashboardReportNotes',
          'updatedAt'
        ]);
      allow delete: if isVerifiedUser()
        && isValidId(projectId)
        && existing().ownerId == request.auth.uid;
    }
  }
}
